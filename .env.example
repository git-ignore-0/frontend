# Public content API used by server-side proxy routes.
CONTENT_API_ORIGIN=http://127.0.0.1:8000
# Must match CONTENT_FRONTEND_REVALIDATE_SECRET in Django; use 32+ random characters.
CONTENT_REVALIDATE_SECRET=

# Server-side Core OAuth settings. Register PUBLIC_SITE_ORIGIN/api/auth/callback in Django.
AUTH_ORIGIN=http://127.0.0.1:8000
PUBLIC_SITE_ORIGIN=http://localhost:3000
PUBLIC_OAUTH_CLIENT_ID=
PUBLIC_OAUTH_CLIENT_SECRET=
PUBLIC_SESSION_SECRET=

# Origin used by the imported UI for public brand and editorial assets.
# NEXT_PUBLIC_SITE_ORIGIN=https://naturalfarmingvietnam.com

# Store guest lookup: same dedicated 32+ character secret as Django (server-only).
STORE_BFF_SHARED_SECRET=
# Enable only a single-IP header overwritten by your trusted hosting proxy, e.g. x-real-ip.
# Never enable this for a header visitors can supply without being overwritten.
STORE_CLIENT_IP_HEADER=
